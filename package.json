{
  "name": "baozimh-paperback",
  "version": "1.0.0",
  "repositoryName": "Baozimh Extensions",
  "description": "Baozimh source extension for Paperback 0.8",
  "main": "lib/index.js",
  "scripts": {
    "test": "npm run build && node --test test/unit.test.js",
    "bundle": "npx paperback bundle",
    "serve": "npx paperback serve",
    "dev": "npx nodemon --watch \"**/*.ts\" --ext \"js ts\" --exec \"npm run serve\"",
    "build": "tsc --outDir tmp/build",
    "test:live": "npm run build && node test/run-live.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InsaneGenie/baozimh-paperback.git"
  },
  "author": "Steven Lai",
  "license": "MIT",
  "dependencies": {
    "@paperback/toolchain": "0.8.0-alpha.47",
    "@paperback/types": "0.8.0-alpha.47"
  },
  "devDependencies": {
    "@types/node": "16.11.7",
    "@typescript-eslint/eslint-plugin": "^4.25.0",
    "@typescript-eslint/parser": "^4.25.0",
    "eslint": "^7.27.0",
    "eslint-plugin-modules-newline": "^0.0.6",
    "typescript": "^4.3.2"
  }
}
